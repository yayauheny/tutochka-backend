tutochka.by, www.tutochka.by {
    @backend_routes {
        path /api /api/*
        path /health /health/*
        path /metrics
        path /actuator/prometheus
    }

    handle /telegram/* {
        reverse_proxy backend:{$BACKEND_PORT:8080}
    }

    handle @backend_routes {
        reverse_proxy backend:{$BACKEND_PORT:8080}
    }

    handle {
        reverse_proxy https://tutochka.lovable.app {
            header_up Host tutochka.lovable.app
        }
    }
}

tutochka.xyz, www.tutochka.xyz, tutochka.site, www.tutochka.site {
    redir https://tutochka.by{uri}
}
